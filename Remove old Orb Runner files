<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Aegis Protocol — Classic</title>
<style>
body {
  margin: 0;
  background: #02030a;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
canvas {
  background: radial-gradient(circle at center, #0b1a3a, #02030a);
  border-radius: 20px;
  box-shadow: 0 30px 100px rgba(0,0,0,0.9);
}
</style>
</head>
<body>

<canvas id="game" width="480" height="640"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const core = { x: 240, y: 320, r: 16 };
let angle = 0;
let shieldRadius = 46;
let shieldSize = Math.PI / 3;

let orbs = [];
let spawnTimer = 0;
let spawnRate = 40;
let score = 0;
let gameOver = false;

// Mouse controls shield
document.addEventListener("mousemove", e => {
  const rect = canvas.getBoundingClientRect();
  angle = Math.atan2(
    e.clientY - rect.top - core.y,
    e.clientX - rect.left - core.x
  );
});

// Spawn incoming orb
function spawnOrb() {
  const side = Math.floor(Math.random() * 4);
  let x, y;

  if (side === 0) { x = Math.random() * 480; y = -20; }
  if (side === 1) { x = 500; y = Math.random() * 640; }
  if (side === 2) { x = Math.random() * 480; y = 660; }
  if (side === 3) { x = -20; y = Math.random() * 640; }

  const a = Math.atan2(core.y - y, core.x - x);
  orbs.push({
    x, y,
    r: 10,
    vx: Math.cos(a) * 2,
    vy: Math.sin(a) * 2
  });
}

// Update game
function update() {
  if (gameOver) return;

  spawnTimer++;
  if (spawnTimer > spawnRate) {
    spawnOrb();
    spawnTimer = 0;
  }

  for (let i = orbs.length - 1; i >= 0; i--) {
    const o = orbs[i];
    o.x += o.vx;
    o.y += o.vy;

    const dx = o.x - core.x;
    const dy = o.y - core.y;
    const dist = Math.hypot(dx, dy);

    const orbAngle = Math.atan2(dy, dx);
    const diff = Math.abs(Math.atan2(
      Math.sin(orbAngle - angle),
      Math.cos(orbAngle - angle)
    ));

    // Shield block
    if (dist < shieldRadius && diff < shieldSize / 2) {
      orbs.splice(i, 1);
      score += 10;
      continue;
    }

    // Core hit
    if (dist < core.r + o.r) {
      gameOver = true;
    }
  }
}

// Draw everything
function draw() {
  ctx.clearRect(0, 0, 480, 640);

  // Core glow
  const glow = ctx.createRadialGradient(
    core.x, core.y, 5,
    core.x, core.y, 30
  );
  glow.addColorStop(0, "#9ecbff");
  glow.addColorStop(1, "transparent");
  ctx.fillStyle = glow;
  ctx.beginPath();
  ctx.arc(core.x, core.y, 30, 0, Math.PI * 2);
  ctx.fill();

  // Core
  ctx.fillStyle = "#6ee7ff";
  ctx.beginPath();
  ctx.arc(core.x, core.y, core.r, 0, Math.PI * 2);
  ctx.fill();

  // Shield
  ctx.strokeStyle = "#a78bfa";
  ctx.lineWidth = 7;
  ctx.beginPath();
  ctx.arc(
    core.x,
    core.y,
    shieldRadius,
    angle - shieldSize / 2,
    angle + shieldSize / 2
  );
  ctx.stroke();

  // Orbs
  ctx.fillStyle = "#ff6f91";
  for (const o of orbs) {
    ctx.beginPath();
    ctx.arc(o.x, o.y, o.r, 0, Math.PI * 2);
    ctx.fill();
  }

  // UI
  ctx.fillStyle = "#fff";
  ctx.font = "16px system-ui";
  ctx.fillText("Score: " + score, 14, 24);

  if (gameOver) {
    ctx.font = "28px system-ui";
    ctx.fillText("GAME OVER", 140, 320);
  }
}

// Main loop
function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}

loop();
</script>

</body>
</html>

